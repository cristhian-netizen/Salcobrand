# Salcobrand — sin claves de IA externas
DATA_DIR=/var/data
NEURAVISION_DETECTOR=auto                 # auto | ultralytics | contour
NEURAVISION_DETECTOR_WEIGHTS=/var/data/models/detector.pt
NEURAVISION_MATCHER_WEIGHTS=/var/data/models/encoder.pt
NEURAVISION_MATCHER_METRICS=/var/data/models/metrics.json
NEURAVISION_OCR=tesseract                 # tesseract | none
NEURAVISION_OCR_LANG=spa+eng
# TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata
# Resolución (E1): las fotos se guardan y analizan a ≤ 3000 px (NEURAVISION_STORED_MAX_SIDE); el detector trabaja a 1600 px y
# el OCR / catálogo leen recortes de la imagen original: el OCR con 4 % de margen (NEURAVISION_OCR_MARGIN), el catálogo y la
# memoria visual ajustados a la caja (NEURAVISION_CROP_MARGIN=0: con margen baja la similitud a los packshots).
# NEURAVISION_FULLRES_CROPS=0 vuelve al comportamiento anterior (recortes de la copia de 1600 px). Límites del OCR:
# lado menor >= NEURAVISION_OCR_MIN_SIDE (160), lado mayor <= NEURAVISION_OCR_MAX_SIDE (800; en infra/Dockerfile estaba fijo en
# 480: subirlo a 800 o quitarlo); NEURAVISION_OCR_UPSCALE_BELOW=N amplía ×2 los recortes de lado mayor < N px (0 = apagado).
NEURAVISION_FULLRES_CROPS=1
NEURAVISION_STORED_MAX_SIDE=3000
NEURAVISION_OCR_MAX_SIDE=800
NEURAVISION_OCR_MARGIN=0.04
NEURAVISION_CROP_MARGIN=0

# Prior de posición (E2): alinea lo leído por nivel contra el orden del planograma; solo rellena/confirma con evidencia
# compatible y marca "posible desorden". 0 lo apaga.
NEURAVISION_POSITION_PRIOR=1
# Lector de formato (E3): para gemelos de la misma marca con arte idéntico (X3/X12, 50 g/120 g) lee el número impreso con
# el OCR; si no lo lee, no cambia nada. APAGADO por defecto: medido el 5-nov no mejora a 1.600–3.600 px y casi duplica el
# tiempo por foto; queda disponible para fotos de mayor resolución. NEURAVISION_FORMAT_MAX_CROPS acota las lecturas por foto.
NEURAVISION_FORMAT_READER=0
NEURAVISION_FORMAT_MAX_CROPS=24
# Formatos web por título (opcional; por defecto se busca catalogo.json junto a NEURAVISION_CATALOG_DIR o en data/catalogo/<cat>/)
# NEURAVISION_CATALOG_FORMATS=/srv/data/catalogo/salud_sexual/catalogo.json

# Catálogo por apariencia: v2 (5-nov, vistas con color/escala/giros y cabeza con negativos por familia) es el de producción en
# /srv/models/catalogo/salud_sexual; el v1 queda en la imagen en /srv/models/catalogo/salud_sexual_v1 para volver atrás con
# infra/set_env.sh NEURAVISION_CATALOG_DIR=/srv/models/catalogo/salud_sexual_v1 (v1 fue mejor en el render externo de 3 niveles;
# v2 en las escenas con packshots reales). Las primeras fotos reales del piloto deciden.
NEURAVISION_CATALOG_DIR=/srv/models/catalogo/salud_sexual

# Latencia (E4, 5-nov): un solo pase DINOv2 por foto compartido por catálogo, memoria visual y voto de vecinos, y OCR solo en los
# recortes que el catálogo no identifica con seguridad (similitud >= NEURAVISION_OCR_SKIP_CONFIDENT sin rival a menos de
# NEURAVISION_CATALOG_MARGIN). 0 = OCR en todos los recortes (comportamiento anterior). Medido: misma precisión, tiempo a la mitad.
NEURAVISION_OCR_SKIP_CONFIDENT=0.90
